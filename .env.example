# Local development only. Do not expose this unauthenticated MongoDB instance to the network.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=civic_memory
MONGODB_GRIDFS_BUCKET=dataset_files

# API
API_HOST=127.0.0.1
API_PORT=8000
APP_ENV=development

# Embeddings are downloaded/cached locally on first use. Override to use another multilingual model.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=auto
HF_HOME=./.model-cache

# Dataset pipeline
INGESTION_CHUNK_SIZE=5000
MAX_UPLOAD_SIZE_MB=1024
RAW_DATA_RETENTION_DAYS=0

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_DEFAULT_LOCALE=en

# Image intelligence (local inference; weights/checkpoints must be obtained under their licences)
MEDIA_GRIDFS_BUCKET=media_files
IMAGE_EMBEDDING_MODEL=facebook/dinov2-base
IMAGE_EMBEDDING_DEVICE=auto
ROAD_DAMAGE_DETECTOR_WEIGHTS=./models/road_damage_detector.pt
IMAGE_MAX_UPLOAD_MB=20
IMAGE_MAX_PIXELS=25000000
IMAGE_PROCESSING_ENABLED=true
IMAGE_MODEL_CACHE_DIR=./.model-cache
